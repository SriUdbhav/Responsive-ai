# ==============================================================================
# ResponseAI Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys.
# DO NOT commit '.env' with your real secrets to version control.
# ==============================================================================

# OpenRouter API Key for Multi-Agent LLMs (openai/gpt-4o-mini)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key for Agent Web Search & Retrieval
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Override the model used (defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

